+
+/* V14.7.1 — OR LIVE workflow-first UX simplification */
+.or-tools-menu{position:relative;display:inline-block;text-align:left}
+.or-tools-menu>summary{list-style:none;cursor:pointer;border:1px solid rgba(255,255,255,.28);background:rgba(255,255,255,.1);color:#fff;border-radius:10px;padding:8px 12px;font-weight:850}
+.or-tools-menu>summary::-webkit-details-marker{display:none}
+.or-tools-menu-body{position:absolute;right:0;top:calc(100% + 7px);z-index:65;width:220px;display:grid;gap:7px;padding:9px;border:1px solid #bfd1d6;border-radius:12px;background:#fff;box-shadow:0 14px 34px rgba(0,31,42,.18)}
+.or-tools-menu-body .btn{width:100%;text-align:left;color:var(--primary);background:#fff;border-color:#cad8dc}
+.or-tools-menu-body .btn.primary{background:var(--primary);color:#fff}
+
+.or-primary-flow{display:flex;align-items:center;justify-content:space-between;gap:16px;margin:10px 0 11px;padding:14px 16px;border:2px solid #8dbec9;border-radius:16px;background:linear-gradient(135deg,#f8fdfe,#edf8fa);box-shadow:0 6px 18px rgba(13,82,101,.07)}
+.or-primary-copy{min-width:0;display:flex;flex-direction:column;gap:2px}
+.or-primary-copy>span{font-size:.66rem;font-weight:950;letter-spacing:.07em;color:#52717b}
+.or-primary-copy>b{font-size:1.12rem;color:#0b5365}
+.or-primary-copy>small{color:#5f7179;line-height:1.35}
+.or-primary-buttons{display:flex;align-items:center;justify-content:flex-end;gap:8px;flex-wrap:wrap}
+.or-primary-action{min-height:54px;border:0;border-radius:13px;padding:12px 18px;background:#0d5265;color:#fff;font-weight:950;font-size:1rem;cursor:pointer;box-shadow:0 5px 14px rgba(13,82,101,.18)}
+.or-primary-action:disabled{opacity:.55;cursor:not-allowed}
+.or-secondary-action{min-height:48px;padding:10px 14px}
+
+/* Sticky row already contains the critical status/time/due/record controls. */
+.or-live-page>.or-status-row{display:none}
+
+.or-phase-details{padding:0!important;overflow:hidden}
+.or-phase-details>summary{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 12px;cursor:pointer;list-style:none}
+.or-phase-details>summary::-webkit-details-marker{display:none}
+.or-phase-details .or-phase-current{margin:0;padding:0;border:0;background:transparent;flex:1}
+.or-phase-details .or-phase-steps,.or-phase-details .or-phase-action-hint{margin-left:12px;margin-right:12px}
+.or-phase-details .or-phase-action-hint{margin-bottom:12px}
+.or-phase-expand{font-size:.73rem;font-weight:850;color:#0d6275;white-space:nowrap}
+
+.or-collapsible-panel{padding:0!important;overflow:visible}
+.or-collapsible-summary{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 15px;cursor:pointer;list-style:none;border-radius:15px}
+.or-collapsible-summary::-webkit-details-marker{display:none}
+.or-collapsible-summary>span:first-child{min-width:0}
+.or-collapsible-summary b{display:block;color:#174b59}
+.or-collapsible-summary small{display:block;margin-top:2px;color:var(--muted);font-weight:650;line-height:1.3}
+.or-collapsible-metric{font-weight:900;color:#0c6174;white-space:nowrap;font-size:.8rem}
+.or-collapsible-body{padding:0 15px 15px;border-top:1px solid #e1eaed}
+.or-collapsible-panel[open]>.or-collapsible-summary{background:#f5fbfc;border-radius:15px 15px 0 0}
+.or-collapsible-panel[open]>.or-collapsible-summary .or-collapsible-metric{color:#0b5265}
+
+/* Active Alerts / Problems is the single visible problem workspace. The older duplicate lists stay in DOM for compatibility/reporting. */
+.or-live-page .or-alert-panel,.or-live-page .complication-watch-panel{display:none}
+.or-workflow-problems{grid-column:span 1}
+.or-workflow-problems #orProblemPanel>.empty-state{padding:10px 4px}
+
+.or-event-problem-menu .or-action-buttons{padding-top:12px}
+.legacy-milestone-hooks{display:none!important}
+
+/* Keep fluid/airway available but out of the primary visual path until needed. */
+.or-fluid-panel,.airway-panel{margin-top:10px}
+.airway-panel[open]{scroll-margin-top:95px}
+.or-fluid-panel[open]{scroll-margin-top:95px}
+
+@media(max-width:780px){
+  .or-primary-flow{align-items:stretch;flex-direction:column}
+  .or-primary-buttons{display:grid;grid-template-columns:1fr 1fr;width:100%}
+  .or-primary-action{grid-column:1/-1;width:100%}
+  .or-primary-buttons .btn{width:100%}
+  .or-tools-menu-body{right:auto;left:0}
+}
+@media(max-width:520px){
+  .or-primary-flow{padding:12px}
+  .or-primary-buttons{grid-template-columns:1fr}
+  .or-primary-action{grid-column:auto}
+  .or-collapsible-summary{align-items:flex-start;flex-direction:column}
+  .or-collapsible-metric{white-space:normal}
+  .or-phase-details>summary{align-items:flex-start}
+}
+.or-protocol-details{margin-top:8px;border-top:1px solid var(--line);padding-top:8px}
+.or-protocol-details>summary{cursor:pointer;color:#4d6771;font-size:.72rem;font-weight:850;list-style:none}
+.or-protocol-details>summary::-webkit-details-marker{display:none}
+.or-protocol-details .protocol-toolbar{margin-bottom:6px}
+/* SAP/DAP remain stored and available in Advanced/record views, but are removed from the primary OR cockpit. */
+.or-live-page .or-bp-panel .sap-dap-helper{display:none!important}
+.or-live-page .or-maint-grid{grid-template-columns:repeat(4,minmax(0,1fr))}
+@media(max-width:760px){.or-live-page .or-maint-grid{grid-template-columns:1fr 1fr}}
