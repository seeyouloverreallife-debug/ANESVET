@@ -0,0 +1,31 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import assert from 'node:assert/strict';
+const root=path.resolve(path.dirname(new URL(import.meta.url).pathname),'..');
+const html=fs.readFileSync(path.join(root,'index.html'),'utf8');
+const css=fs.readFileSync(path.join(root,'style.css'),'utf8');
+const app=fs.readFileSync(path.join(root,'app.js'),'utf8');
+const must=(c,m)=>assert.ok(c,m);
+
+// Phase-changing actions require explicit confirmation rather than advancing on first tap.
+for(const id of ['orStepConfirmDialog','orStepConfirmTitle','orStepConfirmText','orStepConfirmGoBtn','orStepConfirmCancelBtn'])must(html.includes(`id="${id}"`),`missing confirmation UI ${id}`);
+must(app.includes('const OR_WORKFLOW_ACTION_META=')&&app.includes("'start-induction':{title:'Start induction?'")&&app.includes("'surgery-end':{title:'End surgery?'")&&app.includes("extubation:{title:'Extubation complete?'"),'workflow confirmation metadata incomplete');
+must(app.includes("if(orWorkflowActionMeta(action)&&!confirmed){openOrStepConfirm(action);return}"),'phase action does not gate through confirmation');
+must(app.includes("handleOrWorkflowAction(action,{confirmed:true})"),'confirm action does not resume workflow explicitly');
+
+// Last workflow step can be undone with audit retention, including after accidental extubation into Recovery.
+for(const id of ['orUndoStepBtn','orMobileUndoBtn','recoveryUndoStepBtn'])must(html.includes(`id="${id}"`),`missing undo control ${id}`);
+must(app.includes('function captureOrWorkflowUndo')&&app.includes('function commitOrWorkflowUndo')&&app.includes('function undoLastOrWorkflowStep'),'workflow undo transaction functions missing');
+must(app.includes("addAudit('WORKFLOW_STEP_UNDONE'")&&app.includes("addAudit('WORKFLOW_STEP_CONFIRMED'"),'undo/confirmation audit trail missing');
+must(app.includes("if(['extubation','recovery'].includes(tx.action))setTab('orlive',{force:true})"),'recovery/extubation undo must return to OR LIVE');
+must(app.includes('Undo blocked: clinical data was recorded after this step'),'unsafe undo guard missing');
+
+// Intraoperative recurring action is vitals; phase progression is visually secondary.
+must(css.includes('.or-mobile-dock.intraop')&&css.includes('grid-template-areas:"vitals next more"'),'intraoperative dock priority layout missing');
+must(css.includes('#orMobileRecordBtn{grid-area:vitals;background:#0d5265')||css.includes('#orMobileRecordBtn{grid-area:vitals'),'intraoperative vitals primary styling missing');
+must(app.includes("dock.classList.toggle('intraop',intraop)")&&app.includes("b.textContent=due?'RECORD VITALS • DUE':intraop?'RECORD VITALS':'VITALS'"),'dynamic intraoperative vitals priority missing');
+
+// OR start path freezes case identity/BW just like the hospital pilot safety model.
+must(app.includes('function startCaseFromOr')&&app.includes('state.caseIdentitySnapshot={patientMasterId:'),'OR LIVE start path must freeze patient identity/BW');
+
+console.log('ANESVET V15.2.0 OR LIVE confirmation / undo / vitals-priority contracts: PASS');
